функция интеграл(n)
    болсын a = 0.0
    болсын b = 100.0
    болсын h = (b - a) / n
    болсын total = 0.0
    болсын i = 0
    әзірше i < n
        болсын x = a + (i + 0.5) * h
        болсын sx = синус(x)
        болсын cx = косинус(x * 0.5)
        болсын fx = sx * sx + cx
        total = total + fx * h
        i = i + 1
    қайтару total

болсын бастау = уақыт()
болсын res = интеграл(5000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(res)
жазу("TIME_MS:")
жазу(мс)
