функция жай_сандар(шек)
    болсын n = шек + 1
    болсын сүзгі = жаңа_тізім(n, 1)
    сүзгі[0] = 0
    сүзгі[1] = 0

    болсын p = 2
    әзірше p * p <= шек
        егер сүзгі[p] == 1
            болсын i = p * p
            әзірше i <= шек
                сүзгі[i] = 0
                i = i + p
        p = p + 1

    болсын санақ = 0
    болсын k = 2
    әзірше k <= шек
        егер сүзгі[k] == 1
            санақ = санақ + 1
        k = k + 1
    қайтару санақ

болсын бастау = уақыт()
болсын нәтиже = жай_сандар(10000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
