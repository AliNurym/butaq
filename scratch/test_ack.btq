функция акк(m, n)
    егер m == 0
        қайтару n + 1
    егер n == 0
        қайтару акк(m - 1, 1)
    қайтару акк(m - 1, акк(m, n - 1))

болсын бастау = уақыт()
болсын res = акк(3, 10)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(res)
жазу("TIME_MS:")
жазу(мс)
