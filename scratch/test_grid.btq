функция тор_қосындысы(n)
    болсын total = 0
    болсын i = 0
    әзірше i < n
        болсын j = 0
        әзірше j < n
            total = total + (i + j) * (i - j)
            j = j + 1
        i = i + 1
    қайтару total

болсын бастау = уақыт()
болсын res = тор_қосындысы(5000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(res)
жазу("TIME_MS:")
жазу(мс)
