функция мандельброт(w, h, max_iter)
    болсын total = 0
    болсын y = 0
    әзірше y < h
        болсын cy = -1.5 + (3.0 * y) / h
        болсын x = 0
        әзірше x < w
            болсын cx = -2.0 + (3.0 * x) / w
            болсын zx = 0.0
            болсын zy = 0.0
            болсын i = 0
            әзірше i < max_iter
                болсын zx2 = zx * zx
                болсын zy2 = zy * zy
                егер zx2 + zy2 > 4.0
                    үзу
                zy = 2.0 * zx * zy + cy
                zx = zx2 - zy2 + cx
                i = i + 1
            total = total + i
            x = x + 1
        y = y + 1
    қайтару total

болсын бастау = уақыт()
болсын res = мандельброт(500, 500, 500)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(res)
жазу("TIME_MS:")
жазу(мс)
