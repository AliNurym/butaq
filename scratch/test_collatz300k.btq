функция коллатц_макс(шек)
    болсын макс_ұзындық = 0
    болсын макс_сан = 0
    болсын n = 1
    әзірше n <= шек
        болсын c = n
        болсын l = 0
        әзірше c > 1
            болсын q = бүтін(c / 2)
            егер c == q * 2
                c = q
            әйтпесе
                c = 3 * c + 1
            соңы
            l = l + 1
        соңы
        егер l > макс_ұзындық
            макс_ұзындық = l
            макс_сан = n
        соңы
        n = n + 1
    соңы
    қайтару макс_сан
соңы

болсын бастау = уақыт()
болсын нәтиже = коллатц_макс(300000)
болсын соңы_уақыт = уақыт()
болсын мс = (соңы_уақыт - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("BUTAQ_TIME:")
жазу(мс)
