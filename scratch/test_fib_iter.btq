функция фиб(n)
    егер n <= 1 сонда қайтару n
    болсын a = 0
    болсын b = 1
    болсын i = 2
    әзірше i <= n
        болсын c = a + b
        a = b
        b = c
        i = i + 1
    қайтару b

жазу("=== Жылдам Фибоначчи O(n) ===")

болсын i = 0
әзірше i <= 10
    жазу("fib(", i, ") = ", фиб(i))
    i = i + 1
