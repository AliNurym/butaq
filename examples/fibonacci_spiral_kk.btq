# ==============================================================================
# Butaq Fibonacci Phyllotaxis Spiral (Фибоначчи филотаксис спиралі)
# Mathematical sunflower & pinecone golden spiral growth animation
# Арнайы Римдегі Халықаралық Фибоначчи Конгресіне арналған
# ==============================================================================

# Экранды тазалау және курсорды жасыру
жазу("\x1b[?25l\x1b[2J")

болсын алтын_бұрыш = 2.39996323
болсын белгілер = ".:*#@%$"

болсын бұрылу = 0.0
болсын кадр_номері = 0

әзірше ақиқат
    # Экран буфері 60x26
    болсын экран = жаңа_тізім(1560, " ")

    болсын max_нүкте = 240

    болсын n = 0
    әзірше n < max_нүкте
        болсын n_float = сан(n)
        болсын радиус = 0.72 * түбір(n_float)
        болсын бұрыш = n_float * алтын_бұрыш + бұрылу

        # Терминал үшін координаттар (x пропорциясы ~2.0)
        болсын x = бүтін(30.0 + радиус * косинус(бұрыш) * 2.1)
        болсын y = бүтін(13.0 + радиус * синус(бұрыш))

        егер x >= 0 және x < 60 және y >= 0 және y < 26
            болсын индекс = y * 60 + x
            болсын деңгей = бүтін(радиус * 0.6)
            егер деңгей < 0
                деңгей = 0
            егер деңгей > 6
                деңгей = 6
            экран[индекс] = белгілер[деңгей]
        n = n + 1

    # Кадрды жинақтау
    болсын кадр = "\x1b[H"
    кадр = кадр + "   🌀 FIBONACCI PHYLLOTAXIS SPIRAL — NATURE'S SACRED CODE 🌀\n"
    болсын жол_y = 0
    әзірше жол_y < 24
        болсын жол = ""
        болсын баған_x = 0
        әзірше баған_x < 60
            жол = жол + экран[жол_y * 60 + баған_x]
            баған_x = баған_x + 1
        кадр = кадр + жол + "\n"
        жол_y = жол_y + 1

    кадр = кадр + "   Formula: r = c·√n, θ = n·137.5077° | Sunflower & Pinecone"
    жазу(кадр)

    бұрылу = бұрылу + 0.04
    кадр_номері = кадр_номері + 1
    ұйықтау(0.025)
