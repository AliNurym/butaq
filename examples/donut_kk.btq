# ==============================================================================
# Butaq 3D Donut (Айналмалы 3D Тор / Бублик)
# 3D ASCII Raymarching & Z-buffering animation in native Butaq
# Шексіз айналдыру үшін цикл шартын 'әзірше ақиқат' деп өзгертуге болады
# ==============================================================================

болсын A = 0.0
болсын B = 0.0

# Экранды толық тазалау және курсорды жасыру (Clear screen & hide cursor)
жазу("\x1b[?25l\x1b[2J")

болсын кадр_саны = 0
әзірше ақиқат
    болсын b = жаңа_тізім(880, " ")
    болсын z = жаңа_тізім(880, 0.0)

    болсын sin_A = синус(A)
    болсын cos_A = косинус(A)
    болсын sin_B = синус(B)
    болсын cos_B = косинус(B)

    # Тордың бетіндегі нүктелерді есептеу
    болсын j = 0.0
    әзірше j < 6.28
        болсын sin_j = синус(j)
        болсын cos_j = косинус(j)
        
        болсын i = 0.0
        әзірше i < 6.28
            болсын sin_i = синус(i)
            болсын cos_i = косинус(i)
            
            болсын h = cos_j + 2.0
            болсын D = 1.0 / (sin_i * h * sin_A + sin_j * cos_A + 5.0)
            болсын t = sin_i * h * cos_A - sin_j * sin_A
            
            # Экрандағы координаталары (x: 0..39, y: 0..21)
            болсын x = бүтін(20.0 + 18.0 * D * (cos_i * h * cos_B - t * sin_B))
            болсын y = бүтін(11.0 + 9.0 * D * (cos_i * h * sin_B + t * cos_B))
            
            # Беттік нормаль мен жарық көзінің скаляр көбейтіндісі (Luminance)
            болсын N = бүтін(8.0 * ((sin_j * sin_A - sin_i * cos_j * cos_A) * cos_B - sin_i * cos_j * sin_A - sin_j * cos_A - cos_i * cos_j * sin_B))
            
            егер y >= 0 және y < 22 және x >= 0 және x < 40
                болсын idx = y * 40 + x
                егер D > z[idx]
                    z[idx] = D
                    егер N > 0 және N < 12
                        b[idx] = ".,-~:;=!*#$@"[N]
                    әйтпесе
                        b[idx] = "."
            
            i = i + 0.08
        j = j + 0.04

    # Кадр буферін жинақтау және экран басына шығару
    болсын кадр = "\x1b[H"
    болсын жол_y = 0
    әзірше жол_y < 22
        болсын жол = ""
        болсын баған_x = 0
        әзірше баған_x < 40
            жол = жол + b[жол_y * 40 + баған_x]
            баған_x = баған_x + 1
        кадр = кадр + жол + "\n"
        жол_y = жол_y + 1

    жазу(кадр)
    A = A + 0.08
    B = B + 0.04
    кадр_саны = кадр_саны + 1
    ұйықтау(0.03)
