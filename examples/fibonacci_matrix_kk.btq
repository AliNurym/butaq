# ==============================================================================
# Butaq Fast Matrix Fibonacci O(log n)
# Жылдам матрицалық дәрежелеу арқылы Фибоначчи сандарын есептеу
# Арнайы Римдегі Халықаралық Фибоначчи Конгресіне арналған
# ==============================================================================

# 2x2 матрицаларды көбейту: C = A * B
функция матрица_көбейту(A, B)
    болсын C = жаңа_тізім(4, 0.0)
    C[0] = A[0] * B[0] + A[1] * B[2]
    C[1] = A[0] * B[1] + A[1] * B[3]
    C[2] = A[2] * B[0] + A[3] * B[2]
    C[3] = A[2] * B[1] + A[3] * B[3]
    қайтару C

# Матрицаны p дәрежесіне шығару: M^p уақыты O(log p)
функция матрица_дәреже(M, p)
    # Бірлік матрица I
    болсын нәтиже = жаңа_тізім(4, 0.0)
    нәтиже[0] = 1.0
    нәтиже[3] = 1.0

    болсын негіз = жаңа_тізім(4, 0.0)
    негіз[0] = M[0]
    негіз[1] = M[1]
    негіз[2] = M[2]
    негіз[3] = M[3]

    болсын дәреже = бүтін(p)
    әзірше дәреже > 0
        болсын жарты = бүтін(дәреже / 2)
        # Тақ дәреже болса нәтижеге көбейтеміз
        егер дәреже - жарты * 2 == 1
            нәтиже = матрица_көбейту(нәтиже, негіз)
        негіз = матрица_көбейту(негіз, негіз)
        дәреже = жарты
    қайтару нәтиже

# F(n) есептеу
функция фибо_матрица(n)
    егер n <= 0 сонда қайтару 0.0
    егер n == 1 сонда қайтару 1.0
    
    болсын T = жаңа_тізім(4, 0.0)
    T[0] = 1.0
    T[1] = 1.0
    T[2] = 1.0
    T[3] = 0.0

    болсын Tn = матрица_дәреже(T, n - 1)
    қайтару Tn[0]

жазу("══════════════════════════════════════════════════════════════════")
жазу("   ⚡ BUTAQ FAST MATRIX FIBONACCI O(log n) — ROME CONGRESS DEMO")
жазу("══════════════════════════════════════════════════════════════════")
жазу("")

болсын сынақтар = [10, 20, 30, 40, 50, 60, 70]
болсын idx = 0
әзірше idx < 7
    болсын n = сынақтар[idx]
    болсын бастау = уақыт()
    болсын мән = фибо_матрица(n)
    болсын аяқтау = уақыт()
    болсын мкс = (аяқтау - бастау) * 1000000.0

    жазу("F(", n, ") = ", мән, "  [есептеу уақыты: ", мкс, " микросекунд]")
    idx = idx + 1

жазу("")
жазу("Теория: 2x2 матрицаны дәрежелеу O(log n) қадамда орындалады.")
жазу("F(1000) небәрі 10 матрица көбейтуін талап етеді!")
