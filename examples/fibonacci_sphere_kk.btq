# ==============================================================================
# Butaq 3D Fibonacci Golden Sphere (Фибоначчи алтын сферасы)
# Fibonacci Lattice / Golden Angle (137.5°) 3D Projection in native Butaq
# Арнайы Римдегі Халықаралық Фибоначчи Конгресіне арналған
# ==============================================================================

# Экранды тазалау және курсорды жасыру
жазу("\x1b[?25l\x1b[2J")

болсын N = 160
болсын алтын_бұрыш = 2.39996323

болсын A = 0.0
болсын B = 0.0

болсын белгілер = ".,-~:;=!*#$@"

әзірше ақиқат
    # Экран буфері 60x24 (1440 таңба)
    болсын экран = жаңа_тізім(1440, " ")
    болсын z_буфер = жаңа_тізім(1440, -100.0)

    болсын sin_A = синус(A)
    болсын cos_A = косинус(A)
    болсын sin_B = синус(B)
    болсын cos_B = косинус(B)

    # Фибоначчи сферасындағы нүктелерді есептеу
    болсын i = 0
    әзірше i < N
        болсын i_float = сан(i)
        # y координатасы (+1.0 ден -1.0 ге дейін)
        болсын y0 = 1.0 - (i_float / сан(N - 1)) * 2.0
        болсын радиус = түбір(1.0 - y0 * y0)
        болсын тета = i_float * алтын_бұрыш

        болсын x0 = радиус * косинус(тета)
        болсын z0 = радиус * синус(тета)

        # 3D айналу (Rotation)
        болсын x1 = x0 * cos_B + z0 * sin_B
        болсын z_temp = 0.0 - x0 * sin_B + z0 * cos_B
        болсын y1 = y0 * cos_A - z_temp * sin_A
        болсын z1 = y0 * sin_A + z_temp * cos_A

        # Перспективалық проекция
        болсын қашықтық = z1 + 2.7
        егер қашықтық > 0.2
            болсын D = 1.0 / қашықтық
            болсын sx = бүтін(30.0 + 36.0 * x1 * D)
            болсын sy = бүтін(12.0 - 18.0 * y1 * D)

            егер sx >= 0 және sx < 60 және sy >= 0 және sy < 24
                болсын индекс = sy * 60 + sx
                егер D > z_буфер[индекс]
                    z_буфер[индекс] = D
                    
                    # Жарық түсуі (Luminance)
                    болсын жарық = 0.577 * x1 + 0.577 * y1 - 0.577 * z1
                    егер z1 > 0.0
                        болсын char_idx = бүтін((жарық + 1.0) * 5.0)
                        егер char_idx < 0
                            char_idx = 0
                        егер char_idx > 11
                            char_idx = 11
                        экран[индекс] = белгілер[char_idx]
                    әйтпесе
                        # Сфераның артқы жағы - жеңіл нүкте
                        экран[индекс] = "."
        i = i + 1

    # Кадрды шығару
    болсын кадр = "\x1b[H"
    кадр = кадр + "   ✦ FIBONACCI GOLDEN SPHERE (3D) — ROMA CONGRESS DEMO ✦\n"
    болсын жол_y = 0
    әзірше жол_y < 23
        болсын жол = ""
        болсын баған_x = 0
        әзірше баған_x < 60
            жол = жол + экран[жол_y * 60 + баған_x]
            баған_x = баған_x + 1
        кадр = кадр + жол + "\n"
        жол_y = жол_y + 1

    кадр = кадр + "   Golden Angle: 137.5077° | Φ: 1.6180339 | Points: " + мәтін(N)
    жазу(кадр)

    A = A + 0.05
    B = B + 0.03
    ұйықтау(0.02)
