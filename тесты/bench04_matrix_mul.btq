# Butaq Benchmark 4: 2x2 Matrix Fast Power x 500,000
функция матрица_көбейту(A, B)
    болсын C = жаңа_тізім(4, 0.0)
    C[0] = A[0] * B[0] + A[1] * B[2]
    C[1] = A[0] * B[1] + A[1] * B[3]
    C[2] = A[2] * B[0] + A[3] * B[2]
    C[3] = A[2] * B[1] + A[3] * B[3]
    қайтару C

функция матрица_дәреже(M, p)
    болсын нәтиже = жаңа_тізім(4, 0.0)
    нәтиже[0] = 1.0
    нәтиже[3] = 1.0
    болсын негіз = жаңа_тізім(4, 0.0)
    негіз[0] = M[0]
    негіз[1] = M[1]
    негіз[2] = M[2]
    негіз[3] = M[3]
    болсын дәреже = бүтін(p)
    әзірше дәреже > 0
        болсын жарты = бүтін(дәреже / 2)
        егер дәреже - жарты * 2 == 1
            нәтиже = матрица_көбейту(нәтиже, негіз)
        негіз = матрица_көбейту(негіз, негіз)
        дәреже = жарты
    қайтару нәтиже

болсын бастау = уақыт()
болсын ans = 0.0
болсын T = [1.0, 1.0, 1.0, 0.0]
болсын k = 0
әзірше k < 500000
    болсын res = матрица_дәреже(T, 30)
    ans = res[0]
    k = k + 1
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(бүтін(ans))
жазу("TIME_MS:")
жазу(мс)
