# Butaq Benchmark 6: Collatz Sequence max steps up to 100,000
функция коллатц_ұзындығы(бастапқы)
    болсын n = бүтін(бастапқы)
    болсын қадам = 0
    әзірше n > 1
        болсын жарты = бүтін(n / 2)
        егер n - жарты * 2 == 0
            n = жарты
        әйтпесе
            n = 3 * n + 1
        қадам = қадам + 1
    қайтару қадам

болсын бастау = уақыт()
болсын ең_үлкен = 0
болсын i = 1
әзірше i <= 100000
    болсын s = коллатц_ұзындығы(i)
    егер s > ең_үлкен
        ең_үлкен = s
    i = i + 1
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(ең_үлкен)
жазу("TIME_MS:")
жазу(мс)
