# Butaq Top Benchmark 5: Tak (Takeuchi) Deep Recursion tak(33, 16, 8)
функция tak(x, y, z)
    егер y < x
        қайтару tak(tak(x - 1, y, z), tak(y - 1, z, x), tak(z - 1, x, y))
    қайтару z

болсын бастау = уақыт()
болсын res = tak(33, 16, 8)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(res)
жазу("TIME_MS:")
жазу(мс)
