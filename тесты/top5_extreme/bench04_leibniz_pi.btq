# Butaq Top Benchmark 4: Leibniz Gregory-Nilakantha Pi (50,000,000 iter)
функция пи_есептеу(n)
    болсын қосынды = 0.0
    болсын таңба = 1.0
    болсын k = 0
    әзірше k < n
        қосынды = қосынды + таңба / (2.0 * k + 1.0)
        таңба = 0.0 - таңба
        k = k + 1
    қайтару қосынды * 4.0

болсын бастау = уақыт()
болсын нәтиже = пи_есептеу(50000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
