# Butaq Top Benchmark 1: Prime Counting by Trial Division (1,000,000)
функция жай_сандар_саны(n)
    болсын count = 0
    болсын i = 2
    әзірше i <= n
        болсын is_prime = 1
        болсын d = 2
        әзірше d * d <= i
            болсын q = бүтін(i / d)
            егер i - q * d == 0
                is_prime = 0
                үзу
            d = d + 1
        егер is_prime == 1
            count = count + 1
        i = i + 1
    қайтару count

болсын бастау = уақыт()
болсын нәтиже = жай_сандар_саны(1000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
