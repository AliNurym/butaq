# Butaq Benchmark 7: Sum of Squares 10,000,000 iterations
функция шаршылар_қосындысы(n)
    болсын қосынды = 0
    болсын модуль = 1000000007
    болсын i = 1
    әзірше i <= n
        қосынды = қосынды + i * i
        болсын q = бүтін(қосынды / модуль)
        қосынды = қосынды - q * модуль
        i = i + 1
    қайтару қосынды

болсын бастау = уақыт()
болсын нәтиже = шаршылар_қосындысы(10000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
