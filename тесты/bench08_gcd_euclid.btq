# Butaq Benchmark 8: GCD Euclid 1,000,000 pairs
функция еүоб(бастапқы_а, бастапқы_б)
    болсын a = бастапқы_а
    болсын b = бастапқы_б
    әзірше b != 0
        болсын q = бүтін(a / b)
        болсын rem = a - q * b
        a = b
        b = rem
    қайтару a

болсын бастау = уақыт()
болсын жалпы = 0
болсын i = 1
әзірше i <= 1000000
    жалпы = жалпы + еүоб(i, i + 17)
    i = i + 1
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(жалпы)
жазу("TIME_MS:")
жазу(мс)
