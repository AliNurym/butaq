# Butaq Benchmark 9: Array Reduction 100,000 x 50 passes
болсын N = 100000
болсын arr = жаңа_тізім(N, 0.0)
болсын i = 0
әзірше i < N
    болсын v = i * 3 + 7
    болсын q = бүтін(v / 1000)
    arr[i] = сан(v - q * 1000)
    i = i + 1

болсын бастау = уақыт()
болсын total = 0.0
болсын p = 0
әзірше p < 50
    болсын j = 0
    әзірше j < N
        total = total + arr[j]
        j = j + 1
    p = p + 1
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(бүтін(total))
жазу("TIME_MS:")
жазу(мс)
