# Butaq Benchmark 10: Golden Ratio Reciprocal 10,000,000 iterations
функция алтын_қима(n)
    болсын x = 1.0
    болсын i = 0
    әзірше i < n
        x = 1.0 + 1.0 / x
        i = i + 1
    қайтару x

болсын бастау = уақыт()
болсын нәтиже = алтын_қима(10000000)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
