# Butaq Итеративті Фибоначчи бенчмаркі
функция фибо_итер(n)
    егер n <= 1 сонда қайтару n
    болсын a = 0
    болсын b = 1
    болсын i = 2
    әзірше i <= n
        болсын c = a + b
        a = b
        b = c
        i = i + 1
    қайтару b

болсын n = 70
болсын қайталау = 10000
болсын бастау = уақыт()
болсын нәтиже = 0
болсын k = 0
әзірше k < қайталау
    нәтиже = фибо_итер(n)
    k = k + 1
болсын аяқтау = уақыт()

болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:", нәтиже)
жазу("TIME_MS:", мс)
