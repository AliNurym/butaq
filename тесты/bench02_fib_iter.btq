# Butaq Benchmark 2: Iterative Fibonacci F(80) x 500,000
функция фибо_итер(n)
    егер n <= 1 сонда қайтару n
    болсын a = 0
    болсын b = 1
    болсын i = 2
    әзірше i <= n
        болсын c = a + b
        a = b
        b = c
        i = i + 1
    қайтару b

болсын бастау = уақыт()
болсын нәтиже = 0
болсын k = 0
әзірше k < 500000
    нәтиже = фибо_итер(80)
    k = k + 1
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
