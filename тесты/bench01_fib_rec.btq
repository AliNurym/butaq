# Butaq Benchmark 1: Recursive Fibonacci F(32)
функция фибо(n)
    егер n <= 1 сонда қайтару n
    қайтару фибо(n - 1) + фибо(n - 2)

болсын бастау = уақыт()
болсын нәтиже = фибо(32)
болсын аяқтау = уақыт()
болсын мс = (аяқтау - бастау) * 1000.0

жазу("RESULT:")
жазу(нәтиже)
жазу("TIME_MS:")
жазу(мс)
